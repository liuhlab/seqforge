# python
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
build/
dist/
# seqforge working state (resumable, content-addressed — never committed).
#
# ANCHORED, and it has to be. An unanchored `seqforge/` matches a directory of that name at ANY
# depth, which in this repo is `src/seqforge/` — git would ignore our own source tree, silently.
# The leading slash pins it to the repo root, which is where a `-C .` run puts it.
/seqforge/
.seqforge/
# docs build
site/
# editor / OS
.DS_Store
.vscode/settings.local.json

# Slurm job logs (lab convention: `mkdir -p sbatch` in the submit dir)
sbatch/

# Local scratch harnesses. `_*_test.py` / `_test_*.py` are collected by pytest but are nobody's
# deliverable -- they exist to answer one question during an investigation and then stop mattering.
# Ignored so a broad `git add` cannot sweep one into a commit, which is how `_scratch2_test.py`
# reached main twice in one PR.
/tests/_*_test.py
/tests/_test_*.py
